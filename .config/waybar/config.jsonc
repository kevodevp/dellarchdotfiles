{
  "layer": "top",
  "position": "top",
  "exclusive": true,
  "modules-left": [
    "hyprland/workspaces"
  ],
  "modules-center": [],
  "modules-right": [
    "image#cover",
    "custom/music",
    "pulseaudio",
    "network",
    "memory",
    "disk",
    "clock",
    "tray",
    "custom/power"
  ],
  "reload_style_on_change": true,

  "hyprland/workspaces": {
    "format": "{icon}",
    "tooltip": false,
    "all-outputs": false,
    "sort-by-number": true,
    "disable-scroll": false,
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"+1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"-1\" })'",
    "active-only": false,
    "show-special": false
  },

  "tray": {
    "format": "{icon}",
    "tooltip": true,
    "icon-size": 14,
    "spacing": 0
  },

  "pulseaudio": {
    "format": "<span color='#b48ead'>{icon}</span> {volume}%",
    "format-muted": "<span color='#7f8c8d'>󰝟</span> {volume}%",
    "format-icons": ["󰕿", "󰖀", "󰕾"],
    "tooltip": true,
    "tooltip-format": "Output · {volume}%\n󰕾 Left click: devices · Right click: mute",
    "scroll-step": 5,
    "on-click": "/home/brunomars/.local/bin/volume-menu",
    "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-click-middle": "pavucontrol"
  },

  "network": {
    "interval": 5,
    "format-wifi": "<span color='#b48ead'>󰖩</span> {essid}",
    "format-ethernet": "<span color='#b48ead'>󰈀</span> {ifname}",
    "format-linked": "<span color='#7f8c8d'>󰈀</span> {ifname}",
    "format-disconnected": "<span color='#ef6155'>󰖪</span> offline",
    "tooltip": true,
    "tooltip-format": "{ifname} · {ipaddr}/{cidr}\nGateway {gwaddr}\n󰇧 Left click: network · Right click: DNS",
    "on-click": "/home/brunomars/.local/bin/network-menu",
    "on-click-right": "/home/brunomars/.local/bin/network-menu dns",
    "on-click-middle": "/home/brunomars/.local/bin/network-menu details"
  },

  "image#cover": {
    "path": "/home/brunomars/.cache/waybar/cover.img",
    "size": 16,
    "interval": 1,
    "tooltip": false,
    "on-click": "/home/brunomars/.config/waybar/scripts/music-popup.py"
  },
  "custom/music": {
    "exec": "/home/brunomars/.config/waybar/scripts/music-bar.py",
    "return-type": "json",
    "exec-on-event": false,
    "restart-interval": 2,
    "escape": true,
    "hide-empty-text": true,
    "tooltip": true,
    "on-click": "/home/brunomars/.config/waybar/scripts/music-popup.py",
    "on-click-middle": "playerctl play-pause",
    "on-click-right": "playerctl next",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous"
  },

  "memory": {
    "format": "<span color='#b48ead'>󰍛</span> {used:0.1f}G",
    "tooltip": true,
    "tooltip-format": "RAM · {used:0.1f}G used / {total:0.1f}G total ({percentage}%)",
    "interval": 4
  },
  "disk": {
    "interval": 30,
    "unit": "GB",
    "format": "<span color='#b48ead'>󰋊</span> {specific_used:0.2f}G",
    "path": "/",
    "tooltip": true,
    "tooltip-format": "Root · {specific_used:0.2f}G used / {specific_total:0.2f}G ({percentage_used}%)",
    "states": {
      "warning": 80,
      "critical": 95
    }
  },

  "custom/power": {
    "format": "󰐥",
    "tooltip": false,
    "on-click": "/home/brunomars/.local/bin/power-menu"
  },

  "clock": {
    "format": "<span color='#b48ead'>󰥔</span> {:%H:%M}",
    "format-alt": "<span color='#b48ead'>󰃰</span> {:%A, %B %d, %Y}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "year",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "first-day-of-week": 1,
      "on-scroll": 1,
      "on-click-right": "mode",
      "format": {
        "months": "<span color='#b48ead'><b>{}</b></span>",
        "days": "<span color='#eff0f1'><b>{}</b></span>",
        "weeks": "<span color='#7f8c8d'><b>W{}</b></span>",
        "weekdays": "<span color='#815ba4'><b>{}</b></span>",
        "today": "<span color='#b48ead'><b><u>{}</u></b></span>"
      }
    }
  }
}
